[Unit]
Description=Photo frame display (Chromium kiosk in the cage compositor)
After=systemd-user-sessions.service plymouth-quit-wait.service photoframe.service
Wants=dbus.socket systemd-logind.service photoframe.service
After=dbus.socket systemd-logind.service
Conflicts=getty@tty1.service
After=getty@tty1.service
ConditionPathExists=/dev/tty1

[Service]
Type=simple
User=@USER@
PAMName=photoframe-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
UtmpIdentifier=tty1
UtmpMode=user
Environment=FRAME_URL=http://127.0.0.1:80/frame
# touch-only frame: use the transparent cursor theme installed by install.sh
Environment=XCURSOR_THEME=photoframe-blank
Environment=XCURSOR_SIZE=24
# Uncomment if the picture appears rotated (values: normal, 90, 180, 270)
#Environment=FRAME_ROTATE=90
ExecStart=/usr/bin/cage -d -s -- @REPO@/deploy/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
